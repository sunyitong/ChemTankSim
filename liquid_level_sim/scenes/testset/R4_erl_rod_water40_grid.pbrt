# test-set scene -> R4_erl_rod_water40_grid.exr
LookAt 0 -60 9.25  0 0 9.25  0 0 1
Camera "perspective" "float fov" [24]
Sampler "zsobol" "integer pixelsamples" [160]
Integrator "volpath" "integer maxdepth" [48] "bool regularize" [false]
PixelFilter "gaussian"
Film "rgb" "string filename" ["R4_erl_rod_water40_grid.exr"] "integer xresolution" [900] "integer yresolution" [1200] "bool savefp16" [false]

WorldBegin
AttributeBegin  # light panel (Lambertian light box)
  AreaLightSource "diffuse" "string filename" ["../../outputs/testset/patterns/grid.png"] "float scale" [0.8] "bool twosided" true
  Material "diffuse" "rgb reflectance" [0 0 0]
  Shape "trianglemesh" "point3 P" [30 25 -30.75 -30 25 -30.75 -30 25 49.25 30 25 49.25] "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3]
AttributeEnd
LightSource "infinite" "rgb L" [0.2 0.2 0.21]
AttributeBegin  # matte black pedestal
  Material "diffuse" "rgb reflectance" [0.04 0.04 0.04]
  Shape "cylinder" "float radius" [4] "float zmin" [-8.05] "float zmax" [-0.05]
  Shape "disk" "float height" [-0.05] "float radius" [4]
AttributeEnd
MakeNamedMaterial "glass" "string type" "dielectric" "float eta" [1.5]
MakeNamedMaterial "wall_out" "string type" "dielectric" "float eta" [1.5]
MakeNamedMaterial "wall_in_dry" "string type" "dielectric" "float eta" [1.5]
AttributeBegin  # outer wall
  NamedMaterial "wall_out"
  Shape "plymesh" "string filename" ["mesh_erlenmeyer_outer.ply"]
AttributeEnd
AttributeBegin  # rim + outer bottom
  NamedMaterial "glass"
  Shape "disk" "float height" [18.5] "float radius" [2.1] "float innerradius" [1.88]
  AttributeBegin
    ReverseOrientation
    Shape "disk" "float height" [0] "float radius" [6.5]
  AttributeEnd
AttributeEnd
AttributeBegin  # inner bottom (glass|liquid)
  MediumInterface "" "liq1"
  Material "dielectric" "float eta" [1.12528]
  Shape "disk" "float height" [0.45] "float radius" [6.12796]
AttributeEnd
AttributeBegin  # inner wall wetted by water
  MediumInterface "" "liq1"
  Material "dielectric" "float eta" [1.12528]
  Shape "plymesh" "string filename" ["mesh_erlenmeyer_inner_0.450_7.670.ply"]
AttributeEnd
AttributeBegin  # inner wall wetted by water
  MediumInterface "" "liq1"
  Material "dielectric" "float eta" [1.12528]
  Shape "plymesh" "string filename" ["mesh_erlenmeyer_inner_7.670_7.970.ply"]
AttributeEnd
AttributeBegin  # dry inner wall
  NamedMaterial "wall_in_dry"
  Shape "plymesh" "string filename" ["mesh_erlenmeyer_inner_7.970_18.500.ply"]
AttributeEnd
MakeNamedMedium "liq1" "string type" "homogeneous" "rgb sigma_a" [0.0035 0.0015 0.0003] "rgb sigma_s" [0 0 0] "float scale" [1]
AttributeBegin  # free surface + meniscus
  MediumInterface "liq1" ""
  Material "dielectric" "float eta" [1.333]
  Translate 0 0 7.67
  Shape "plymesh" "string filename" ["mesh_R4_erl_rod_water40_grid_surface.ply"]
AttributeEnd
AttributeBegin  # rod (steel)
  MediumInterface "" "liq1"
  Material "conductor" "spectrum eta" "metal-Al-eta" "spectrum k" "metal-Al-k" "float roughness" [0.10] "bool remaproughness" [false]
  Translate 0.9 0 0
  Shape "cylinder" "float radius" [0.3] "float zmin" [2.255] "float zmax" [7.67]
AttributeEnd
AttributeBegin  # rod (steel)
  MediumInterface "" ""
  Material "conductor" "spectrum eta" "metal-Al-eta" "spectrum k" "metal-Al-k" "float roughness" [0.10] "bool remaproughness" [false]
  Translate 0.9 0 0
  Shape "cylinder" "float radius" [0.3] "float zmin" [7.67] "float zmax" [24.5]
AttributeEnd
AttributeBegin  # rod lower end
  MediumInterface "" "liq1"
  Material "conductor" "spectrum eta" "metal-Al-eta" "spectrum k" "metal-Al-k" "float roughness" [0.10] "bool remaproughness" [false]
  Translate 0.9 0 0
  ReverseOrientation
  Shape "disk" "float height" [2.255] "float radius" [0.3]
AttributeEnd
