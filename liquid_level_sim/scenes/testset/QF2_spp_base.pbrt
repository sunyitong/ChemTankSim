# test-set scene -> QF2_spp_base.exr
LookAt 0 -60 9.25  0 0 9.25  0 0 1
Camera "perspective" "float fov" [24]
Sampler "zsobol" "integer pixelsamples" [256]
Integrator "volpath" "integer maxdepth" [48] "bool regularize" [false]
PixelFilter "gaussian"
Film "rgb" "string filename" ["QF2_spp_base.exr"] "integer xresolution" [450] "integer yresolution" [600] "bool savefp16" [false]

WorldBegin
AttributeBegin  # light panel (Lambertian light box)
  AreaLightSource "diffuse" "string filename" ["../../outputs/testset/patterns/mosaic.png"] "float scale" [0.8] "bool twosided" true
  Material "diffuse" "rgb reflectance" [0 0 0]
  Shape "trianglemesh" "point3 P" [30 25 -30.75 -30 25 -30.75 -30 25 49.25 30 25 49.25] "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin  # environment light
  Rotate 0 0 0 1
  LightSource "infinite" "string filename" ["../../outputs/env/childrens_hospital_equiarea.exr"] "float scale" [0.788643]
AttributeEnd
AttributeBegin  # matte black pedestal
  Material "diffuse" "rgb reflectance" [0.04 0.04 0.04]
  Shape "cylinder" "float radius" [4] "float zmin" [-8.05] "float zmax" [-0.05]
  Shape "disk" "float height" [-0.05] "float radius" [4]
AttributeEnd
MakeNamedMaterial "glass" "string type" "dielectric" "float eta" [1.5]
MakeNamedMaterial "wall_out" "string type" "dielectric" "float eta" [1.5]
MakeNamedMaterial "wall_in_dry" "string type" "dielectric" "float eta" [1.5]
AttributeBegin  # outer wall
  NamedMaterial "wall_out"
  Shape "plymesh" "string filename" ["mesh_erlenmeyer_outer.ply"]
AttributeEnd
AttributeBegin  # rim + outer bottom
  NamedMaterial "glass"
  Shape "disk" "float height" [18.5] "float radius" [2.1] "float innerradius" [1.88]
  AttributeBegin
    ReverseOrientation
    Shape "disk" "float height" [0] "float radius" [6.5]
  AttributeEnd
AttributeEnd
AttributeBegin  # inner bottom (dry)
  NamedMaterial "glass"
  Shape "disk" "float height" [0.45] "float radius" [6.12796]
AttributeEnd
AttributeBegin  # dry inner wall
  NamedMaterial "wall_in_dry"
  Shape "plymesh" "string filename" ["mesh_erlenmeyer_inner_0.450_18.500.ply"]
AttributeEnd

AttributeBegin  # tube (ptfe)
  MediumInterface "" ""
  Material "diffuse" "rgb reflectance" [0.86 0.86 0.84]
  Translate 0.8 0.2 0
  Shape "cylinder" "float radius" [0.4] "float zmin" [15.251] "float zmax" [25.5]
AttributeEnd
AttributeBegin  # tube lower end
  MediumInterface "" ""
  Material "diffuse" "rgb reflectance" [0.86 0.86 0.84]
  Translate 0.8 0.2 0
  ReverseOrientation
  Shape "disk" "float height" [15.251] "float radius" [0.4]
AttributeEnd
