# test-set scene -> V4_reagent_line92full_water60_baseline.exr
LookAt 0 -60 9.25  0 0 9.25  0 0 1
Camera "perspective" "float fov" [24]
Sampler "zsobol" "integer pixelsamples" [192]
Integrator "volpath" "integer maxdepth" [48] "bool regularize" [false]
PixelFilter "gaussian"
Film "rgb" "string filename" ["V4_reagent_line92full_water60_baseline.exr"] "integer xresolution" [900] "integer yresolution" [1200] "bool savefp16" [false]

WorldBegin
AttributeBegin  # light panel (Lambertian light box)
  AreaLightSource "diffuse" "string filename" ["../../outputs/testset/patterns/rg_checker.png"] "float scale" [0.8] "bool twosided" true
  Material "diffuse" "rgb reflectance" [0 0 0]
  Shape "trianglemesh" "point3 P" [30 25 -30.75 -30 25 -30.75 -30 25 49.25 30 25 49.25] "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3]
AttributeEnd
LightSource "infinite" "rgb L" [0.25 0.25 0.2625]
AttributeBegin  # matte black pedestal
  Material "diffuse" "rgb reflectance" [0.04 0.04 0.04]
  Shape "cylinder" "float radius" [3.5] "float zmin" [-8.05] "float zmax" [-0.05]
  Shape "disk" "float height" [-0.05] "float radius" [3.5]
AttributeEnd
MakeNamedMaterial "glass" "string type" "dielectric" "float eta" [1.5]
Texture "sAmtDry" "float" "imagemap" "string filename" ["../../outputs/testset/textures/scale_amount_dry_line92_full_reagent.png"] "string encoding" "linear"
Texture "sAmtWet" "float" "imagemap" "string filename" ["../../outputs/testset/textures/scale_amount_wet_line92_full_reagent.png"] "string encoding" "linear"
Texture "sThick" "float" "imagemap" "string filename" ["../../outputs/testset/textures/scale_thick_line92_full_reagent.png"] "string encoding" "linear"
Texture "sRefl" "spectrum" "imagemap" "string filename" ["../../outputs/testset/textures/scale_refl_line92_full_reagent.png"]
Texture "sTrans" "spectrum" "imagemap" "string filename" ["../../outputs/testset/textures/scale_trans_line92_full_reagent.png"]
MakeNamedMaterial "wall_out" "string type" "dielectric" "float eta" [1.5]
MakeNamedMaterial "dep_diffuse" "string type" "diffusetransmission" "texture reflectance" "sRefl" "texture transmittance" "sTrans"
MakeNamedMaterial "dep_fwd_dry" "string type" "dielectric" "float eta" [1.5] "float roughness" [0.22] "bool remaproughness" false
MakeNamedMaterial "deposit_dry" "string type" "mix" "string materials" ["dep_fwd_dry" "dep_diffuse"] "texture amount" "sThick"
MakeNamedMaterial "wall_in_dry" "string type" "mix" "string materials" ["glass" "deposit_dry"] "texture amount" "sAmtDry"
AttributeBegin  # outer wall
  NamedMaterial "wall_out"
  Shape "plymesh" "string filename" ["mesh_reagent_outer.ply"]
AttributeEnd
AttributeBegin  # rim + outer bottom
  NamedMaterial "glass"
  Shape "disk" "float height" [18.5] "float radius" [2.8] "float innerradius" [2.52]
  AttributeBegin
    ReverseOrientation
    Shape "disk" "float height" [0] "float radius" [5]
  AttributeEnd
AttributeEnd
AttributeBegin  # inner bottom (dry)
  NamedMaterial "glass"
  Shape "disk" "float height" [0.6] "float radius" [4.72]
AttributeEnd
AttributeBegin  # dry inner wall
  NamedMaterial "wall_in_dry"
  Shape "plymesh" "string filename" ["mesh_reagent_inner_0.600_18.500.ply"]
AttributeEnd

