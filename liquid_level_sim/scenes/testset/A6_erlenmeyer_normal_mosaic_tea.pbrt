# test-set scene -> A6_erlenmeyer_normal_mosaic_tea.exr
LookAt 0 -60 11.25  0 0 11.25  0 0 1
Camera "perspective" "float fov" [24]
Sampler "zsobol" "integer pixelsamples" [160]
Integrator "volpath" "integer maxdepth" [48] "bool regularize" [true]
PixelFilter "gaussian"
Film "rgb" "string filename" ["A6_erlenmeyer_normal_mosaic_tea.exr"] "integer xresolution" [900] "integer yresolution" [1200] "bool savefp16" [false]

WorldBegin
AttributeBegin  # light panel (Lambertian light box)
  AreaLightSource "diffuse" "string filename" ["../../outputs/testset/patterns/mosaic.png"] "float scale" [0.8] "bool twosided" true
  Material "diffuse" "rgb reflectance" [0 0 0]
  Shape "trianglemesh" "point3 P" [30 25 -28.75 -30 25 -28.75 -30 25 51.25 30 25 51.25] "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin  # matte black pedestal
  Material "diffuse" "rgb reflectance" [0.04 0.04 0.04]
  Shape "cylinder" "float radius" [4] "float zmin" [-8.05] "float zmax" [-0.05]
  Shape "disk" "float height" [-0.05] "float radius" [4]
AttributeEnd
MakeNamedMaterial "glass" "string type" "dielectric" "float eta" [1.5]
MakeNamedMaterial "wall_out" "string type" "dielectric" "float eta" [1.5]
MakeNamedMaterial "wall_in_dry" "string type" "dielectric" "float eta" [1.5]
AttributeBegin  # outer wall
  NamedMaterial "wall_out"
  Shape "plymesh" "string filename" ["mesh_erlenmeyer_outer.ply"]
AttributeEnd
AttributeBegin  # rim + outer bottom
  NamedMaterial "glass"
  Shape "disk" "float height" [18.5] "float radius" [2.1] "float innerradius" [1.88]
  AttributeBegin
    ReverseOrientation
    Shape "disk" "float height" [0] "float radius" [6.5]
  AttributeEnd
AttributeEnd
AttributeBegin  # inner bottom (glass|liquid)
  MediumInterface "" "liq1"
  Material "dielectric" "float eta" [1.1236]
  Shape "disk" "float height" [0.45] "float radius" [6.12796]
AttributeEnd
AttributeBegin  # inner wall wetted by tea
  MediumInterface "" "liq1"
  Material "dielectric" "float eta" [1.1236]
  Shape "plymesh" "string filename" ["mesh_erlenmeyer_inner_0.450_8.031.ply"]
AttributeEnd
AttributeBegin  # inner wall wetted by tea
  MediumInterface "" "liq1"
  Material "dielectric" "float eta" [1.1236]
  Shape "plymesh" "string filename" ["mesh_erlenmeyer_inner_8.031_8.331.ply"]
AttributeEnd
AttributeBegin  # dry inner wall
  NamedMaterial "wall_in_dry"
  Shape "plymesh" "string filename" ["mesh_erlenmeyer_inner_8.331_18.500.ply"]
AttributeEnd
MakeNamedMedium "liq1" "string type" "homogeneous" "rgb sigma_a" [0.05 0.18 0.45] "rgb sigma_s" [0 0 0] "float scale" [1]
AttributeBegin  # free surface + meniscus
  MediumInterface "liq1" ""
  Material "dielectric" "float eta" [1.335]
  Translate 0 0 8.031
  Shape "plymesh" "string filename" ["mesh_A6_erlenmeyer_normal_mosaic_tea_surface.ply"]
AttributeEnd
